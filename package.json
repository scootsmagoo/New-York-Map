{
  "name": "new-york-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "An interactive, pannable timeline of New York City's history, from Lenapehoking to Greater New York (1919). Inspired by Gotham by Burrows & Wallace.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "validate:wiki": "node scripts/validate-wiki-titles.mjs",
    "prepare:overlays": "node scripts/prepare-overlays.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.8",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "mapshaper": "^0.7.22",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.0"
  }
}
